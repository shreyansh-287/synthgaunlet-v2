# ============================================================================
# Synthetic Data Forge - environment configuration
# Copy to .env for local development:  cp .env.example .env
# ============================================================================

# ---- LLM: Gemini ---------------------------------------------------------
LLM_PROVIDER=gemini
# LOCAL DEV: Gemini Developer API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# CLOUD RUN / VERTEX AI: set this to "true" to route through Vertex AI instead
# of the Developer API. When true, GEMINI_API_KEY is ignored and the service
# uses Application Default Credentials (the Cloud Run service account).
GOOGLE_GENAI_USE_VERTEXAI=false
GCP_PROJECT=
VERTEX_LOCATION=us-central1
# Google OAuth 2.0 Web Client ID for browser BigQuery authentication (Optional)
# Create in GCP Console: APIs & Services -> Credentials -> Create OAuth Client ID (Web application)
GOOGLE_CLIENT_ID=

# Model ids (override per-agent if you like)
GENERATOR_MODEL=gemini-3.6-flash
ATTACKER_MODEL=gemini-3.6-flash
ORCHESTRATOR_MODEL=gemini-3.6-flash
REPORTER_MODEL=gemini-3.6-flash

# ---- Adversarial loop -----------------------------------------------------
MAX_ROUNDS=5
FIDELITY_MIN=0.82
TSTR_MIN=0.85
QUERY_EQUIVALENCE_MIN=0.95
REID_MAX=0.01
MEMBERSHIP_MAX=0.60
DEFAULT_N_ROWS=2000

# ---- Reidentification tuning ---------------------------------------------
REID_THRESHOLD=0.10

# ---- BigQuery metadata history -------------------------------------------
BQ_HISTORY_DATASET=synthgauntlet
BQ_HISTORY_TABLE=sidebar_history
BQ_HISTORY_LOCATION=US
HISTORY_LIMIT=25

# ---- Sidebar history metadata ---------------------------------------------
BQ_HISTORY_DATASET=synthgauntlet
BQ_HISTORY_TABLE=sidebar_history
BQ_HISTORY_LOCATION=US
HISTORY_LIMIT=25

# ---- Server ---------------------------------------------------------------
PORT=8080
